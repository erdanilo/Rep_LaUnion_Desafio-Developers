import React from 'react';
import Slider from 'react-slick';
import 'slick-carousel/slick/slick.css';
import 'slick-carousel/slick/slick-theme.css';


const styles = {
    card: {
      border: '1px solid #ccc',
      borderRadius: '8px',
      padding: '10px',
      width: '200px',
      textAlign: 'center',
      boxShadow: '0 4px 8px rgba(0,0,0,0.1)',
      margin: '10px',
    },
    avatar: {
      borderRadius: '50%',
      width: '50px',
      height: '50px',
    },
    imagen: {
      width: '150px',
      height: '150px',
      objectFit: 'cover',
      marginTop: '10px',
    },
  };

// Datos de ejemplo
const personajes = [
  {
    id: 1,
    nombre: 'Personaje 1',
    avatar: 'https://via.placeholder.com/50', // URL del avatar
    imagen: 'https://via.placeholder.com/150', // URL de la imagen del personaje
    puntaje: 95,
  },
  {
    id: 2,
    nombre: 'Personaje 2',
    avatar: 'https://via.placeholder.com/50',
    imagen: 'https://via.placeholder.com/150',
    puntaje: 88,
  },
  {
    id: 3,
    nombre: 'Personaje 3',
    avatar: 'https://via.placeholder.com/50',
    imagen: 'https://via.placeholder.com/150',
    puntaje: 72,
  },
  {
    id: 4,
    nombre: 'Personaje 4',
    avatar: 'https://via.placeholder.com/50',
    imagen: 'https://via.placeholder.com/150',
    puntaje: 80,
  },
  {
    id: 5,
    nombre: 'Personaje 5',
    avatar: 'https://via.placeholder.com/50',
    imagen: 'https://via.placeholder.com/150',
    puntaje: 92,
  },
];

const PersonajeCard = ({ personaje }) => {
  return (
    <div style={styles.card}>
      <img src={personaje.avatar} alt={`${personaje.nombre} Avatar`} style={styles.avatar} />
      <h3>{personaje.nombre}</h3>
      <img src={personaje.imagen} alt={personaje.nombre} style={styles.imagen} />
      <p>Puntaje: {personaje.puntaje}</p>
    </div>
  );
};

const ListaPersonajes = () => {
  const settings = {
    dots: true,
    infinite: true,
    speed: 500,
    slidesToShow: 3,
    slidesToScroll: 1,
    responsive: [
      {
        breakpoint: 1024, // Para pantallas medianas
        settings: {
          slidesToShow: 2,
        },
      },
      {
        breakpoint: 600, // Para pantallas pequeñas
        settings: {
          slidesToShow: 1,
        },
      },
    ],
  };

  return (
    <Slider {...settings}>
      {personajes.map((personaje) => (
        <PersonajeCard key={personaje.id} personaje={personaje} />
      ))}
    </Slider>
  );
};



const ResumenCarrusel = () => {
  return (
    <div>
      <h1>Lista de Personajes</h1>
      <ListaPersonajes />
    </div>
  );
};

export default ResumenCarrusel;

